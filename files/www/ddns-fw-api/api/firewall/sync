#!/bin/sh

printf 'Content-Type: application/json\r\n'
printf 'Cache-Control: no-store\r\n'

respond() {
	printf 'Status: %s\r\n\r\n' "$1"
	printf '%s\n' "$2"
	exit "${3:-0}"
}

[ "$REQUEST_METHOD" = POST ] || respond '405 Method Not Allowed' '{"ok":false,"error":"POST required"}' 0

. /lib/functions.sh
config_load ddns_fw
config_get expected main token ''
[ -n "$expected" ] || respond '503 Service Unavailable' '{"ok":false,"error":"webhook token is not configured"}' 0

provided="$HTTP_X_API_TOKEN"
case "$HTTP_AUTHORIZATION" in
	[Bb]earer\ *) provided="${HTTP_AUTHORIZATION#* }" ;;
esac
[ -n "$provided" ] && [ "$provided" = "$expected" ] || {
	/usr/sbin/ddns-fw log warn "webhook rejected remote=${REMOTE_ADDR:-unknown} auth=failed"
	respond '401 Unauthorized' '{"ok":false,"error":"invalid token"}' 0
}

case "$CONTENT_LENGTH" in ''|*[!0-9]*) respond '400 Bad Request' '{"ok":false,"error":"invalid content length"}' 0;; esac
[ "$CONTENT_LENGTH" -le 16384 ] || respond '413 Payload Too Large' '{"ok":false,"error":"payload too large"}' 0

IFS= read -r -n "$CONTENT_LENGTH" body
[ -n "$body" ] || respond '400 Bad Request' '{"ok":false,"error":"empty JSON body"}' 0

result="$(/usr/sbin/ddns-fw webhook "$body" "${REMOTE_ADDR:-unknown}" 2>/dev/null)"
rc=$?
[ "$rc" -eq 0 ] || respond '400 Bad Request' "${result:-{\"ok\":false,\"error\":\"invalid payload\"}}" 0
respond '200 OK' "$result" 0

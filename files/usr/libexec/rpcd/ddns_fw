#!/bin/sh

case "$1" in
	list)
		cat <<'EOF'
{"status":{},"devices":{},"logs":{"limit":0},"sync":{},"set_master":{"enabled":false},"set_active":{"enabled":false,"interval":0},"test_webhook":{"client_name":"","ipv6":"","ports":""}}
EOF
		;;
	call)
		case "$2" in
			status) exec /usr/sbin/ddns-fw status ;;
			devices) exec /usr/sbin/ddns-fw devices ;;
			logs)
				read -r input
				limit="$(jsonfilter -s "$input" -e '@.limit' 2>/dev/null)"
				exec /usr/sbin/ddns-fw logs "${limit:-100}"
				;;
			sync)
				/usr/sbin/ddns-fw sync luci >/dev/null 2>&1
				exec /usr/sbin/ddns-fw status
				;;
			set_active)
				read -r input
				enabled="$(jsonfilter -s "$input" -e '@.enabled' 2>/dev/null)"
				interval="$(jsonfilter -s "$input" -e '@.interval' 2>/dev/null)"
				case "$enabled" in true|1) enabled=1;; *) enabled=0;; esac
				case "$interval" in 5|10|15|30|60|120|300) ;; *) interval=30;; esac
				uci set ddns_fw.main.active_enabled="$enabled"
				uci set ddns_fw.main.refresh_interval="$interval"
				uci commit ddns_fw
				/etc/init.d/ddns-fw restart >/dev/null 2>&1
				exec /usr/sbin/ddns-fw status
				;;
			set_master)
				read -r input
				enabled="$(jsonfilter -s "$input" -e '@.enabled' 2>/dev/null)"
				case "$enabled" in true|1) enabled=1;; *) enabled=0;; esac
				uci set ddns_fw.main.enabled="$enabled"
				uci commit ddns_fw
				/etc/init.d/ddns-fw restart >/dev/null 2>&1
				[ "$enabled" = 1 ] && /usr/sbin/ddns-fw sync master-enable >/dev/null 2>&1
				exec /usr/sbin/ddns-fw status
				;;
			test_webhook)
				read -r input
				exec /usr/sbin/ddns-fw webhook "$input" luci-test
				;;
		esac
		;;
esac

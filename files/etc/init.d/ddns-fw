#!/bin/sh /etc/rc.common

START=91
STOP=10
USE_PROCD=1

PROG=/usr/sbin/ddns-fw-daemon

start_service() {
	local enabled api_enabled api_port api_bind api_bind6
	config_load ddns_fw
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance daemon
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	config_get_bool api_enabled main api_enabled 1
	[ "$api_enabled" = 1 ] || return 0
	config_get api_port main api_port 9080
	config_get api_bind main api_bind 0.0.0.0
	config_get api_bind6 main api_bind6 ::

	procd_open_instance webhook
	procd_set_param command /usr/sbin/uhttpd -f \
		-p "${api_bind}:${api_port}" -p "[${api_bind6}]:${api_port}" \
		-h /www/ddns-fw-api -x /api/firewall \
		-t 15 -T 30 -k 8 -A 1 -n 3
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ddns_fw
}

reload_service() {
	stop
	start
}

stop_service() {
	/usr/sbin/ddns-fw cleanup >/dev/null 2>&1 || true
}

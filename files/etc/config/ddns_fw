config global 'main'
	option enabled '1'
	option backend 'auto'
	option lan_interface 'lan'
	option wan_interface 'wan6'
	option refresh_interval '30'
	option api_enabled '1'
	option api_port '9080'
	option api_bind '0.0.0.0'
	option api_bind6 '::'
	option token ''
	option allow_payload_ports '1'
	option log_level 'info'

